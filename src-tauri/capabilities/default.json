{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. PRD 7.9: no shell or filesystem plugin is exposed to JavaScript; the UI may only call the app's own commands (build.rs app manifest, commands.txt) and listen to events (drag-and-drop, open-request).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-subscribe-events",
    "allow-get-app-info",
    "allow-get-launch-path",
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-recent-projects",
    "allow-pick-media-file",
    "allow-pick-output-dir",
    "allow-open-path",
    "allow-relink-source",
    "allow-close-project",
    "allow-get-snapshot",
    "allow-add-clip",
    "allow-edit-clips",
    "allow-edit-clips-batch",
    "allow-get-platform-presets",
    "allow-delete-clips",
    "allow-undo",
    "allow-redo",
    "allow-renumber-clips",
    "allow-set-tags",
    "allow-set-export-settings",
    "allow-set-view-state",
    "allow-save-now",
    "allow-crop-window",
    "allow-preview-export",
    "allow-start-export",
    "allow-cancel-export",
    "allow-resume-export",
    "allow-retry-failed",
    "allow-request-playback",
    "allow-start-waveform",
    "allow-get-media-index",
    "allow-reveal-path",
    "allow-open-output-folder",
    "allow-clear-cache",
    "allow-detect-hw-encoders",
    "allow-export-timestamps",
    "allow-save-text-file",
    "allow-parse-timestamps",
    "allow-import-timestamps"
  ]
}
